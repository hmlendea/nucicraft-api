{
  "dataStoreSettings": {
    "countriesStorePath": "Data/countries.json",
    "homesStorePath": "Data/homes.json",
    "itemsStorePath": "Data/items.json",
    "playersStorePath": "Data/players.json",
    "rtpLocationsStorePath": "Data/rtp_locations.json",
    "worldsStorePath": "Data/worlds.json",
    "zonesStorePath": "Data/zones.json",
    "zoneTypesStorePath": "Data/zone_types.json"
  },
  "serverSettings": {
    "name": "NuciCraft",
    "hostname": "mc.nucilandia.ro",
    "javaEditionPort": 25565,
    "bedrockEditionPort": 19132
  },
  "rtpLocationSettings": {
    "minimumLocationDistance": 200,
    "minimumBiomeLocationDistance": 500
  },
  "webMapSettings": {
    "baseUrl": "[[NUCICRAFT_WEBMAP_BASE_URL]]"
  },
  "securitySettings": {
    "apiKey": "[[NUCICRAFT_API_KEY]]"
  },
  "universalNameGeneratorSettings": {
    "baseUrl": "[[UNIVERSAL_NAME_GENERATOR_API_BASE_URL]]",
    "apiKey": "[[UNIVERSAL_NAME_GENERATOR_API_KEY]]"
  },
  "nuciLoggerSettings": {
    "logFilePath": "logfile.log",
    "isFileOutputEnabled": true
  },
  "accessControlSettings": {
    "deniedCountries": [
      "BD",
      "BY",
      "CN",
      "IN",
      "MZ",
      "NP",
      "PK",
      "RU",
      "SA",
      "SG",
      "TR"
    ],
    "deniedUsernamePatterns": [
      "[Oo]fficial",
      "[Ss]canner",
      "[Ss]erver",
      "[Xx]{2}",
      "^[H]erobrine$",
      "^[Pp]layer$",
      "^[Ss]erver$",
      "^Player[0-9]+$",
      "^ScanProbe$",
      "^shepan$",
      "^Test[0-9]+$",
      "Probe$",
      "Scan$"
    ],
    "minimumUsernameLength": 4,
    "geolocationApiUrl": "http://ip-api.com/json/",
    "anonymisationServiceDetection": {
      "isEnabled": true,
      "provider": "proxycheck",
      "isCacheEnabled": true
    }
  }
}
