<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NuciCraft.API</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MineStat" Version="3.1.2" />
    <PackageReference Include="NuciAPI" Version="3.6.2" />
    <PackageReference Include="NuciAPI.Client" Version="1.2.4" />
    <PackageReference Include="NuciAPI.Controllers" Version="2.3.2" />
    <PackageReference Include="NuciAPI.Middleware" Version="2.0.4" />
    <PackageReference Include="NuciAPI.Middleware.ExceptionHandling" Version="1.0.3" />
    <PackageReference Include="NuciAPI.Middleware.Logging" Version="1.0.2" />
    <PackageReference Include="NuciAPI.Middleware.Security" Version="1.0.6" />
    <PackageReference Include="NuciDAL" Version="4.1.1" />
    <PackageReference Include="NuciLog" Version="1.2.3" />
    <PackageReference Include="NuciLog.Core" Version="3.1.1" />
    <PackageReference Include="NuciSecurity.HMAC" Version="4.1.4" />
    <PackageReference Include="NuciText.Normalisation" Version="1.0.3" />
    <PackageReference Include="NuciText.Obfuscation" Version="1.1.2" />
    <PackageReference Include="NuciWeb.HTTP" Version="1.7.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
